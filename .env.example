# Скопировать в .env и заполнить. .env в git не попадает.

# --- Камера (сервис ingest) ---
RTSP_URL=rtsp://USER:PASSWORD@62.64.17.113:2554
# Субпоток камеры: 1920x536, 553 кбит/с против 9,2 Мбит/с у основного.
# Пусто — основной поток.
RTSP_PATH=/Streaming/Channels/102
SPOOL_DIR=/var/spool/hls
HLS_TIME=4

# Перекодирование вниз. Нужно только камере без субпотока, когда аплинк уже
# её основного потока. Любая из двух переменных включает его сама.
# TRANSCODE=1
# VIDEO_BITRATE=2500k
# SCALE_HEIGHT=720

# --- Объектное хранилище (сервис uploader) ---
STREAM_ID=demo
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# MinIO локально: http://localhost:9000
S3_ENDPOINT_URL=
S3_REGION=auto
UPLOAD_INTERVAL=1.0
UPLOAD_WORKERS=8
# Через сколько секунд удалять с диска уже выгруженный сегмент. 0 — не удалять.
SPOOL_RETENTION=300

# --- Веб (сервис web) ---
# Публичный базовый адрес, по которому плеер читает манифест.
# R2: https://pub-<hash>.r2.dev
PUBLIC_BASE_URL=
